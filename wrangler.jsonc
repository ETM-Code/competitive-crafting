{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "competitive-crafting",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-17",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  "routes": [{ "pattern": "competitive-crafting.eoghancollins.com", "custom_domain": true }],
  "observability": { "enabled": true, "redact_query_string": true },
}
