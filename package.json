{
  "name": "competitive-crafting",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:worker": "wrangler dev --port 8787",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && eslint . && vitest run",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/e2e/visual.spec.ts",
    "test:animations": "playwright test tests/e2e/animations.spec.ts",
    "test:worker": "vitest run --config tests/worker/vitest.config.ts",
    "test:runtime": "vitest run --config tests/worker/vitest.runtime.config.ts",
    "test:pwa": "node scripts/verify-pwa.mjs",
    "test:live": "node scripts/live-smoke.mjs",
    "test:music": "node scripts/verify-music.mjs",
    "capture": "node scripts/capture-progress.mjs",
    "capture:video": "node scripts/record-progress.mjs",
    "classify": "node scripts/classify-recipes.mjs",
    "test:load": "node scripts/load.mjs",
    "sync:creative": "node scripts/sync-creative-tabs.mjs",
    "sync:data": "node scripts/sync-minecraft.mjs && node scripts/sync-creative-tabs.mjs && node scripts/classify-recipes.mjs && node scripts/sync-avatars.mjs && node scripts/create-app-icons.mjs && node scripts/sync-panorama.mjs && node scripts/sync-sounds.mjs",
    "sync:playlist": "node scripts/sync-playlist.mjs",
    "deploy": "npm run build && wrangler deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "pannellum": "2.5.7",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260917.1",
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.2",
    "esbuild": "^0.28.1",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "jsqr": "^1.4.0",
    "miniflare": "^5.20260916.0-alpha",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.7",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vitest": "^4.1.0",
    "wrangler": "^4.133.0"
  }
}
